# ──────────────────────────────────────────────────────────
# RAG Backend — Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────

# Mistral AI API key (required)
MISTRAL_API_KEY=JZ3zJdw3KIoRLDXslCHHGJpEZEzqemWD
# Model overrides (optional — defaults shown)
# CHAT_MODEL=mistral-large-latest
# EMBEDDING_MODEL=mistral-embed
# AUDIO_MODEL=voxtral-mini-latest

# Chunking configuration (optional)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200

# Retrieval configuration (optional)
# TOP_K=5

# ChromaDB configuration (optional)
# CHROMA_COLLECTION_NAME=rag_documents
# CHROMA_PERSIST_DIRECTORY=./chroma_db/

# Upload directory (optional)
# UPLOAD_DIRECTORY=./uploads/

# Server configuration (optional)
# HOST=0.0.0.0
# PORT=8000

# CORS origins (optional, comma-separated for multiple)
# CORS_ORIGINS=["*"]

# Frontend directory relative to backend (optional)
# FRONTEND_DIRECTORY=../frontend/
